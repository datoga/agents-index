# Local and Vercel deployments should use managed PostgreSQL (e.g. Neon Marketplace).
DATABASE_URL=postgresql://agents_index:local_only_change_me@localhost:5432/agents_index
POSTGRES_PORT=5432

# Generate independent random secrets: openssl rand -base64 48
OTP_PEPPER=
TOKEN_PEPPER=
ADMIN_SESSION_PEPPER=

# Comma-separated admin emails; these addresses may use the separate admin OTP console.
ADMIN_EMAILS=

# Email delivery via Resend. In development, OTPs are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="agents.index <onboarding@resend.dev>"

# Optional overrides
APP_URL=http://localhost:3000
AVATAR_PRESET_API_BASE_URL=https://api.dicebear.com/10.x
NEXT_PUBLIC_SITE_URL=https://agents.index

# Federation: this instance may be a root index or a child index.
INDEX_NAME=agents.index
INDEX_HANDLE=
PARENT_INDEX_URL=

# Registration: email allows any verified mailbox; domain restricts to the exact
# comma-separated email domains; closed only permits administrator-provisioned users.
REGISTRATION_MODE=email
REGISTRATION_ALLOWED_DOMAINS=
OTP_TTL_SECONDS=600
ADMIN_SESSION_TTL_HOURS=8
API_TOKEN_TTL_DAYS=365
